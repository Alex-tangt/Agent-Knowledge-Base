  "scopes": {
    "corpus": "只读语料：仓库内 .md（复刻 memory_agent/corpus/loader.py 的 EXCLUDE_DIR_NAMES / EXCLUDE_REL_PREFIXES，1MB 上限）",
    "kb": "可写 KB：AGENT_KB_DIR（本机 C:\\Users\\Tan\\.config\\opencode\\knowledge），条目 id 取 frontmatter",
    "repo": "整个仓库工作树（含代码文件）——只读语料**不索引代码**，故这一档对一次性检索结构性不可达"
  },
  "readonly_label": "agent-knowledge-base",
  "faces": [
    "grep",
    "read",
    "outline",
    "history"
  ],
  "baseline": {
    "arm": "one-shot retrieval",
    "chain": "MemoryIndex.search（生产记忆检索链：BGE-M3 dense + BM25 sparse + store 原生 DBSF 融合，rerank 关，pool=14）",
    "metric": "条目级命中：top-k 里是否出现 baseline_entry_id（k = 1/5/10/14）；另报 MRR",
    "not_comparable_note": "history 面与 repo-scope 代码文件没有对应的可索引条目 → baseline_entry_id = null，一次性检索**结构性不可达**，单独作为一层报告，不混进 paired CI。"
