{
  "schema_version": 1,
  "note": "确定性场景评测集（#62 验收②）。零网络、零模型权重：stub_evidence 交给 StubTools 回放，脚本 LLM 回放脚本输出。口径（ADR-0030 D7 / CONTEXT.md）：迭代检索 = 据上一跳结果改写 query 再检索，硬预算 / 无新 id / 充分性信号即停。留出规则：任何调参 / 人眼观察只在 dev；对外报数是 holdout。",
  "defaults": {
    "k": 5,
    "max_hops": 3,
    "max_evidence": 3
  },
  "scenarios": [
    {
      "id": "s01-answer-first-hop",
      "query": "BM25 与向量融合时为什么要先归一化？",
      "split": "dev",
      "kind": "answer",
      "relevant": ["g-bm25-norm"],
      "gold_answer": "不归一化时 BM25 原始分会压住向量的权重",
      "stub_evidence": {
        "BM25 与向量融合时为什么要先归一化？": ["g-bm25-norm", "g-fusion-dbsf"]
      },
      "script": ["ANSWER: 不归一化时 BM25 原始分会压住向量的权重"],
      "expect": {"stop": "answer"}
    },
    {
      "id": "s02-multihop-second-hop",
      "query": "留存目标只召回 65% 时，该用哪套机制去补？",
      "split": "dev",
      "kind": "answer",
      "relevant": ["g-census-r5", "g-agentic-loop"],
      "gold_answer": "迭代检索",
      "stub_evidence": {
        "留存目标只召回 65% 时，该用哪套机制去补？": ["g-census-r5"],
        "多跳问题所需证据跨多篇文档时如何补齐": ["g-agentic-loop"]
      },
      "script": [
        "NEXT_QUERY: 多跳问题所需证据跨多篇文档时如何补齐",
        "ANSWER: 迭代检索"
      ],
      "expect": {"stop": "answer"}
    },
    {
      "id": "s03-multihop-two-extra-hops",
      "query": "in-package harness 的评测对象是什么？",
      "split": "dev",
      "kind": "answer",
      "relevant": ["g-trace-contract", "g-eval-runtime-seam", "g-bootstrap-ci"],
      "gold_answer": "trace 契约",
      "stub_evidence": {
        "in-package harness 的评测对象是什么？": ["g-trace-contract"],
        "评测侧只读契约如何解耦运行时": ["g-eval-runtime-seam"],
        "统计结论用哪种置信区间": ["g-bootstrap-ci"]
