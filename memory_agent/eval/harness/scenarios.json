        "项目里那条从未实现的停止触发词是哪一个？": ["g-trace-contract", "g-stop-catalog"],
        "停止触发词一览是否列了未实现项": ["g-trace-contract", "g-stop-catalog"]
      },
      "script": [
        "NEXT_QUERY: 停止触发词一览是否列了未实现项"
      ],
      "expect": {"stop": "no_new_ids"}
    },
    {
      "id": "s07-fallback-stop",
