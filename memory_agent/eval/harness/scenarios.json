        "ANSWER: trace 契约"
      ],
      "expect": {"stop": "answer"}
    },
    {
      "id": "s04-budget-stop-partial",
      "query": "多跳问题的证据在首跳漏掉时，为什么需要迭代检索？",
      "split": "holdout",
      "kind": "answer",
      "relevant": ["g-census-r5", "g-agentic-loop"],
      "gold_answer": "首跳漏掉的证据只能靠据已有信息改写 query 补回",
      "max_hops": 2,
      "stub_evidence": {
        "多跳问题的证据在首跳漏掉时，为什么需要迭代检索？": ["g-census-r5"],
