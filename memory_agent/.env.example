# memory_agent 配置示例
#
# 用法：复制本文件为 memory_agent/.env 并填入真实值。
# `memory_agent/.env` 已被 .gitignore 忽略（规则 `.env`）——**绝不提交**。
# 本文件（.env.example）不含真实密钥，可以提交。
#
# 优先级：进程环境变量 > `memory_agent/.env`（load_dotenv 不覆盖已存在的环境变量）。
# 加载器见 `memory_agent/settings.py::load_env_file`（#22）；**只读本文件，
# 绝不读 legal_web/.env**。密钥只经环境传入，绝不写进被跟踪文件或日志/异常。

# ---- 云端向量库（企业平面；#23 / #25）----
MEMORY_CLOUD_URI=https://<cluster-endpoint>
MEMORY_CLOUD_TOKEN=<api-key-or-token>
MEMORY_CLOUD_COLLECTION=agent_knowledge_base
# 若用用户名/密码而非 API Key（不推荐：不可限定范围 / 不可轮换）：
# MEMORY_CLOUD_USER=
# MEMORY_CLOUD_PASSWORD=
# 云端集成测试默认跳过；设 1 才跑（会触网，勿进 CI 默认套件）
# MEMORY_CLOUD_TESTS=

# ---- 配置文件路径 ----
# MEMORY_ENV_FILE=           # 覆盖本 .env 的加载路径（默认 memory_agent/.env）

# ---- 真相源 / 语料 ----
# AGENT_KB_DIR=              # 可写真相源（默认全局 KB）
# MEMORY_KB_OWNER=           # 可写 KB 的域所有者（#36）；留空 = 不声明
# MEMORY_READONLY_ROOTS=     # os.pathsep 分隔；空串 = 无只读语料
# MEMORY_READONLY_REPOS_CONFIG=
# MEMORY_OVERLAY_CONFIG=     # overlay 收录清单路径（默认 memory_agent/overlay.json）

# ---- 派生索引 ----
# MEMORY_INDEX_DIR=
# MEMORY_REINDEX_BATCH=16

# ---- 常驻 daemon（#19）----
# MEMORY_MCP_HOST=127.0.0.1
# MEMORY_MCP_PORT=8765
# MEMORY_MCP_PATH=/mcp
# MEMORY_DAEMON_LOG=
# MEMORY_WARMUP=0

# ---- 写入网关 ----
# MEMORY_DEDUP_THRESHOLD=0.88

# ---- 网关：authn / authz（#32 / ADR-0018 D2）----
# 单租户阶段：身份 = 下面这几项（进程配置）。缺省 = 本地 owner、无租户、可读全部密级。
# MEMORY_AUTH_PRINCIPAL=local
# MEMORY_AUTH_TENANT=                 # 绑定租户（组织隔离边界）；留空 = 单租户不绑定
# MEMORY_AUTH_ROLE=owner              # owner | admin | writer | reader
# MEMORY_AUTH_CLASSIFICATIONS=        # 逗号分隔；留空 = private,internal,public
# MEMORY_AUTH_RESIDENCIES=            # 逗号分隔；留空 = local,cloud
# MEMORY_AUTH_OWNERS=                 # 逗号分隔的可写域 owner 集合（#36）；留空 = 不限制
# MEMORY_AUTH_TOKENS 里每身份也可带 "owners": ["me"]（只可收自己拥有的域）
#
# 多租户形状：给 `MEMORY_AUTH_TOKENS` 一个 JSON 映射（token -> 身份）后，daemon 在
# `/mcp` 边界校验 Bearer token；未带 / 无效即拒绝（可显式 REQUIRE_TOKEN=0 关掉）。
# 值是凭据：只经 .env / 环境注入，**绝不提交、绝不写日志**。
# MEMORY_AUTH_TOKENS={"<replace-me>": {"tenant": "org-a", "role": "writer", "principal": "svc-a"}}
# MEMORY_AUTH_REQUIRE_TOKEN=1
# MEMORY_AUDIT_LOG=                   # 默认 <MEMORY_INDEX_DIR>/audit.log（gitignored）
